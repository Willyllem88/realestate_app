{
  "name": "smart-real-estate-portal",
  "version": "0.1.0",
  "private": true,
  "description": "MVP real estate listings platform: crawl -> normalise -> store (MySQL) -> search -> details",
  "engines": { "node": ">=18.17" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx src/db/init.ts",
    "seed": "tsx src/scripts/seed.ts",
    "crawl": "tsx src/scripts/crawl.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
